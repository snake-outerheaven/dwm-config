# ~/.config/cmus/rc - cmus na Gruvbox com destaque vermelho, como o dwm
# Os numeros sao cores do terminal (st na Gruvbox, pelo Xresources do dwm-config):
#   -1 fundo do terminal, 0 #282828, 1 #cc241d, 8 #928374, 9 #fb4934, 15 #fbf1c7
# Musicas: ':add <pasta das suas musicas>' (uma vez) e depois 5 para ver os arquivos.
# Teclas de midia do T420 (Fn+setas) controlam o cmus pelo cmus-remote (config.h do dwm).

# som: no FreeBSD o cmus toca pelo OSS (/dev/dsp)
set output_plugin=oss

set color_win_bg=-1
set color_win_fg=15
set color_win_dir=9
set color_win_title_bg=-1
set color_win_title_fg=9
set color_win_cur=9
set color_win_sel_bg=1
set color_win_sel_fg=15
set color_win_cur_sel_bg=1
set color_win_cur_sel_fg=15
set color_win_inactive_sel_bg=8
set color_win_inactive_sel_fg=0
set color_win_inactive_cur_sel_bg=8
set color_win_inactive_cur_sel_fg=9
set color_separator=8
set color_titleline_bg=1
set color_titleline_fg=15
set color_statusline_bg=-1
set color_statusline_fg=15
set color_cmdline_bg=-1
set color_cmdline_fg=15
set color_error=9
set color_info=9
