# /usr/local/share/dwm-config/dunstrc - notificacoes em Gruvbox com destaque vermelho, como o dwm
# O dwm sobe o dunst com -config apontando para este arquivo.
# Testar: notify-send "Titulo" "Texto"     Recarregar: pkill dunst (o proximo aviso sobe ele de novo)

[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (12, 32)          # abaixo da barra do dwm
    width = 320
    height = (0, 140)
    notification_limit = 5
    font = Cascadia Code 11
    frame_width = 2
    separator_height = 2
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    corner_radius = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = middle
    show_age_threshold = 60
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    highlight = "#cc241d"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#928374"
    timeout = 4

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#cc241d"
    timeout = 6

[urgency_critical]
    background = "#282828"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    highlight = "#fb4934"
    timeout = 0                # fica ate voce fechar
