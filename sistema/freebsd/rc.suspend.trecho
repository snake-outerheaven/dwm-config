# Trecho para o /etc/rc.suspend (FreeBSD): bloqueia a tela antes de dormir.
# O devd chama o /etc/rc.suspend como root a cada suspensao (tampa, zzz,
# acpiconf -s 3). Cole estas linhas ANTES das linhas de sync e sleep do arquivo.
# O xautolock, que o ~/.xinitrc deixa rodando, chama o i3lock.

pid=$(pgrep -n xautolock)
if [ -n "$pid" ]; then
	dono=$(ps -o user= -p "$pid")
	su -l "$dono" -c 'DISPLAY=:0 xautolock -locknow' >/dev/null 2>&1
	sleep 1		# da tempo do i3lock cobrir a tela
fi
