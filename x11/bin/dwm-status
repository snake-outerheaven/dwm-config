#!/bin/sh
# dwm-status - barra do dwm no OpenBSD e no FreeBSD: cpu, memoria, volume, bateria e data
# Tambem avisa (notify-send/dunst) quando a bateria fica baixa: 15% e 5%.
#
# Uso:  dwm-status &     o .xinitrc ja chama assim
#       dwm-status -1    imprime a linha uma vez no terminal, para testar

INTERVALO=5
SO=$(uname -s)

# --- bateria -----------------------------------------------------------------
pct_bateria() {
	case "$SO" in
	FreeBSD)
		pct=$(sysctl -n hw.acpi.battery.life 2>/dev/null)
		case "$pct" in ''|*[!0-9]*) pct= ;; esac
		printf '%s' "$pct"
		return ;;
	esac
	pct=$(apm -l 2>/dev/null)
	case "$pct" in ''|*[!0-9]*) pct= ;; esac
	# apm sem resposta ou "desconhecido" (255): calcula pelos sensores ACPI
	if [ -z "$pct" ] || [ "$pct" -gt 100 ]; then
		cheio=$(sysctl -n hw.sensors.acpibat0.watthour0 2>/dev/null | cut -d' ' -f1)
		resta=$(sysctl -n hw.sensors.acpibat0.watthour3 2>/dev/null | cut -d' ' -f1)
		if [ -n "$cheio" ] && [ -n "$resta" ]; then
			pct=$(echo "$resta $cheio" | awk '{ if ($2 > 0) printf "%d", $1 * 100 / $2 }')
		fi
	fi
	printf '%s' "$pct"
}

na_tomada() {
	case "$SO" in
	FreeBSD) [ "$(sysctl -n hw.acpi.acline 2>/dev/null)" = 1 ] ;;
	*)       [ "$(apm -a 2>/dev/null)" = 1 ] ;;
	esac
}

# --- cpu: uso entre duas leituras do kern.cp_time ----------------------------
# OpenBSD: user,nice,sys,spin,intr,idle   FreeBSD: user nice sys intr idle
# Nos dois o idle e o ultimo campo; a conta abaixo serve para os dois.
cp_time() {
	sysctl -n kern.cp_time 2>/dev/null | tr ',' ' '
}

cpu_pct() {	# $1 = leitura anterior, $2 = leitura atual
	echo "$1 $2" | awk '{
		n = NF / 2; total = 0
		for (i = 1; i <= n; i++) total += $(i + n) - $i
		idle = $(2 * n) - $n
		if (total > 0) printf "%d", 100 * (total - idle) / total
		else printf "?"
	}'
}

# --- memoria: ativa / total, em MB -------------------------------------------
memoria() {
	total=$(sysctl -n hw.physmem 2>/dev/null)
	case "$SO" in
	FreeBSD)
		pag=$(sysctl -n vm.stats.vm.v_active_count 2>/dev/null)
		tam=$(sysctl -n hw.pagesize 2>/dev/null)
		if [ -n "$pag" ] && [ -n "$tam" ] && [ -n "$total" ]; then
			printf 'mem %sM/%sM' "$((pag * tam / 1048576))" "$((total / 1048576))"
		else
			printf 'mem ?'
		fi
		return ;;
	esac
	top -b -d1 2>/dev/null | awk '/^Memory:/ {
		split($3, r, "/"); v = r[1] + 0; u = substr(r[1], length(r[1]))
		if (u == "K") v = v / 1024; else if (u == "G") v = v * 1024
		printf "%d", v
	}' | {
		read -r ativa
		if [ -n "$ativa" ] && [ -n "$total" ]; then
			printf 'mem %sM/%sM' "$ativa" "$((total / 1048576))"
		else
			printf 'mem ?'
		fi
	}
}

# --- volume -------------------------------------------------------------------
# nivel e mudo em 0-1 e 0/1, nos dois sistemas
nivel_volume() {
	case "$SO" in
	FreeBSD) mixer -o vol.volume 2>/dev/null | sed 's/.*=//; s/:.*//' ;;
	*)       sndioctl -n output.level 2>/dev/null ;;
	esac
}

mudo() {
	case "$SO" in
	FreeBSD) [ "$(mixer -o vol.mute 2>/dev/null | sed 's/.*=//')" = on ] ;;
	*)       [ "$(sndioctl -n output.mute 2>/dev/null)" = 1 ] ;;
	esac
}

volume() {
	if mudo; then
		printf 'vol mudo'
		return
	fi
	nivel=$(nivel_volume)
	if [ -n "$nivel" ]; then
		printf 'vol %s%%' "$(echo "$nivel" | awk '{ printf "%d", $1 * 100 + 0.5 }')"
	else
		printf 'vol ?'
	fi
}

# --- aviso de bateria baixa (uma vez por nivel, ate voltar a carregar) -------
avisado=""	# "", "15" ou "5"
avisar_bateria() {	# $1 = pct
	[ -n "$1" ] || return
	command -v notify-send >/dev/null || return
	if na_tomada || [ "$1" -gt 15 ]; then
		avisado=""
		return
	fi
	if [ "$1" -le 5 ] && [ "$avisado" != 5 ]; then
		notify-send -u critical "Bateria em $1%" "Ligue na tomada agora."
		avisado=5
	elif [ "$1" -le 15 ] && [ -z "$avisado" ]; then
		notify-send -u normal "Bateria em $1%" "Hora de procurar a tomada."
		avisado=15
	fi
}

linha() {	# $1 = cpu %, $2 = bateria %
	tomada=""
	na_tomada && tomada="+"
	printf ' cpu %s%% | %s | %s | bat %s%%%s | %s ' \
	    "$1" "$(memoria)" "$(volume)" "${2:-?}" "$tomada" "$(date '+%d/%m %H:%M')"
}

antes=$(cp_time)

if [ "${1:-}" = "-1" ]; then
	sleep 1
	linha "$(cpu_pct "$antes" "$(cp_time)")" "$(pct_bateria)"
	echo
	exit 0
fi

sleep 1
while :; do
	agora=$(cp_time)
	bat=$(pct_bateria)
	avisar_bateria "$bat"
	xsetroot -name "$(linha "$(cpu_pct "$antes" "$agora")" "$bat")"
	antes=$agora
	sleep "$INTERVALO"
done
