#!/bin/sh
# midia - volume e brilho, com o valor novo no dunst (OpenBSD e FreeBSD)
#   OpenBSD: sndioctl e xbacklight      FreeBSD: mixer e backlight (base)
#
# Uso: midia vol+ | vol- | mudo | luz+ | luz-
# O dwm chama pelas teclas de volume e brilho.

SO=$(uname -s)
PASSO_VOL=0.1	# 10%
PASSO_LUZ=10	# 10%

avisar() {	# $1 = titulo, $2 = valor 0-100 (vazio = sem barra)
	command -v notify-send >/dev/null || return 0
	if [ -n "$2" ]; then
		notify-send -t 1500 -h string:x-dunst-stack-tag:midia \
		    -h "int:value:$2" "$1" "$2%"
	else
		notify-send -t 1500 -h string:x-dunst-stack-tag:midia "$1"
	fi
}

pct() {	# 0.700 -> 70
	awk -v n="$1" 'BEGIN { printf "%d", n * 100 + 0.5 }'
}

# --- som ----------------------------------------------------------------------
vol_mudar() {	# $1 = + ou -
	case "$SO" in
	FreeBSD) mixer vol.mute=off "vol.volume=$1$PASSO_VOL" >/dev/null ;;
	*)       sndioctl -q output.mute=0 "output.level=$1$PASSO_VOL" ;;
	esac
}
vol_alternar_mudo() {
	case "$SO" in
	FreeBSD) mixer vol.mute=toggle >/dev/null ;;
	*)       sndioctl -q output.mute=! ;;
	esac
}
vol_nivel() {	# 0-1
	case "$SO" in
	FreeBSD) mixer -o vol.volume | sed 's/.*=//; s/:.*//' ;;
	*)       sndioctl -n output.level ;;
	esac
}
vol_mudo() {
	case "$SO" in
	FreeBSD) [ "$(mixer -o vol.mute | sed 's/.*=//')" = on ] ;;
	*)       [ "$(sndioctl -n output.mute)" = 1 ] ;;
	esac
}

# --- brilho -------------------------------------------------------------------
luz_mudar() {	# $1 = + ou -
	case "$SO" in
	FreeBSD) if [ "$1" = + ]; then backlight incr "$PASSO_LUZ"; else backlight decr "$PASSO_LUZ"; fi ;;
	*)       if [ "$1" = + ]; then xbacklight -inc "$PASSO_LUZ"; else xbacklight -dec "$PASSO_LUZ"; fi ;;
	esac
}
luz_nivel() {	# 0-100
	case "$SO" in
	FreeBSD) backlight -q ;;
	*)       xbacklight -get | cut -d. -f1 ;;
	esac
}

case "${1:-}" in
vol+)	vol_mudar +; avisar "Volume" "$(pct "$(vol_nivel)")" ;;
vol-)	vol_mudar -; avisar "Volume" "$(pct "$(vol_nivel)")" ;;
mudo)	vol_alternar_mudo
	if vol_mudo; then avisar "Volume: mudo"; else avisar "Volume" "$(pct "$(vol_nivel)")"; fi ;;
luz+)	luz_mudar +; avisar "Brilho" "$(luz_nivel)" ;;
luz-)	luz_mudar -; avisar "Brilho" "$(luz_nivel)" ;;
*)	echo "uso: midia vol+ | vol- | mudo | luz+ | luz-" >&2
	exit 1 ;;
esac
