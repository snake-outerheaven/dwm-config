#!/bin/sh
# perfil-maquina - diz se a maquina e "notebook" (tem bateria) ou "desktop"
#
# Ordem de decisao:
#   1. variavel PERFIL=desktop|notebook        (forcar na hora)
#   2. arquivo /etc/dwm-config/perfil         (gravado pelo install.sh)
#   3. deteccao: hw.acpi.battery.units >= 1 e carga de 1 a 100 (FreeBSD)
#
# Uso: perfil-maquina          imprime o perfil
#      perfil-maquina -d       ignora 1 e 2: so a deteccao do hardware

ARQ=/etc/dwm-config/perfil

detectar() {
	# FreeBSD: o acpi_battery(4) conta as baterias em hw.acpi.battery.units;
	# alem disso, so conta como notebook se a carga for de 1 a 100
	u=$(sysctl -n hw.acpi.battery.units 2>/dev/null)
	l=$(sysctl -n hw.acpi.battery.life 2>/dev/null)
	case "$u" in ''|*[!0-9]*) u=0 ;; esac
	case "$l" in ''|*[!0-9]*) l=0 ;; esac
	if [ "$u" -ge 1 ] && [ "$l" -ge 1 ] && [ "$l" -le 100 ]; then
		echo notebook
	else
		echo desktop
	fi
}

valido() { [ "$1" = desktop ] || [ "$1" = notebook ]; }

if [ "${1:-}" = -d ]; then
	detectar
	exit 0
fi

if valido "${PERFIL:-}"; then
	echo "$PERFIL"
elif [ -r "$ARQ" ] && valido "$(head -n1 "$ARQ")"; then
	head -n1 "$ARQ"
else
	detectar
fi
