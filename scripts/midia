#!/bin/sh
# midia - volume (mixer) e brilho (backlight), com o valor novo no dunst
#
# Uso: midia vol+ | vol- | mudo | luz+ | luz-
# O dwm chama pelas teclas de volume e brilho (/usr/local/libexec/dwm-config/midia).
# FreeBSD: mixer(8) e backlight(8) sao do sistema base.

PASSO_VOL=5	# % (relativo a 100%, nao ao valor atual)
PASSO_LUZ=10	# %

avisar() {	# $1 = titulo, $2 = valor 0-100 (vazio = sem barra)
	command -v notify-send >/dev/null || return 0
	if [ -n "$2" ]; then
		notify-send -t 1500 -h string:x-dunst-stack-tag:midia \
		    -h "int:value:$2" "$1" "$2%"
	else
		notify-send -t 1500 -h string:x-dunst-stack-tag:midia "$1"
	fi
}

# --- som ----------------------------------------------------------------------
# mixer -o imprime "controle=valor"; o volume vem como "esq:dir" (0.00 a 1.00)
vol_mudar() {	# $1 = + ou -
	mixer vol.mute=0 "vol=$1$PASSO_VOL%" >/dev/null
}
vol_alternar_mudo() {
	mixer vol.mute=toggle >/dev/null
}
vol_nivel() {	# 0-100
	mixer -o vol.volume 2>/dev/null |
	    awk -F= '{ split($2, c, ":"); printf "%d", c[1] * 100 + 0.5 }'
}
vol_mudo() {
	[ "$(mixer -o vol.mute 2>/dev/null | cut -d= -f2)" = 1 ]
}

# --- brilho -------------------------------------------------------------------
luz_mudar() {	# $1 = + ou -
	if [ "$1" = + ]; then backlight incr "$PASSO_LUZ"; else backlight decr "$PASSO_LUZ"; fi
}
luz_nivel() {	# 0-100
	backlight -q
}

case "${1:-}" in
vol+)	vol_mudar +; avisar "Volume" "$(vol_nivel)" ;;
vol-)	vol_mudar -; avisar "Volume" "$(vol_nivel)" ;;
mudo)	vol_alternar_mudo
	if vol_mudo; then avisar "Volume: mudo"; else avisar "Volume" "$(vol_nivel)"; fi ;;
luz+)	luz_mudar +; avisar "Brilho" "$(luz_nivel)" ;;
luz-)	luz_mudar -; avisar "Brilho" "$(luz_nivel)" ;;
*)	echo "uso: midia vol+ | vol- | mudo | luz+ | luz-" >&2
	exit 1 ;;
esac
