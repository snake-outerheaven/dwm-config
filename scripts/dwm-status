#!/bin/sh
# dwm-status - barra do dwm no FreeBSD: musica, cpu, memoria, volume, bateria e data
# Tambem avisa (notify-send/dunst) quando a bateria fica baixa: 15% e 5%.
# No perfil desktop (sem bateria, ver perfil-maquina) a bateria some da barra
# e nenhum aviso de bateria e mandado.
#
# Uso:  dwm-status &     o dwm sobe sozinho (autostart no config.h)
#       dwm-status -1    imprime a linha uma vez no terminal, para testar

INTERVALO=5

# notebook ou desktop: decidido uma vez, ao iniciar
PERFIL=$("$(dirname "$0")/perfil-maquina" 2>/dev/null || echo notebook)

# --- bateria -----------------------------------------------------------------
pct_bateria() {	# hw.acpi.battery.life: carga em %, de todas as baterias
	pct=$(sysctl -n hw.acpi.battery.life 2>/dev/null)
	case "$pct" in ''|*[!0-9]*) pct= ;; esac
	[ -n "$pct" ] && [ "$pct" -gt 100 ] && pct=
	printf '%s' "$pct"
}

na_tomada() {	# hw.acpi.acline: 1 = na tomada
	[ "$(sysctl -n hw.acpi.acline 2>/dev/null)" = 1 ]
}

# --- cpu: uso entre duas leituras do kern.cp_time ----------------------------
# kern.cp_time no FreeBSD = user nice sys intr idle (o idle e sempre o ultimo)
cp_time() {
	sysctl -n kern.cp_time 2>/dev/null | tr ',' ' '
}

cpu_pct() {	# $1 = leitura anterior, $2 = leitura atual
	echo "$1 $2" | awk '{
		n = NF / 2; total = 0
		for (i = 1; i <= n; i++) total += $(i + n) - $i
		idle = $(2 * n) - $n
		if (total > 0) printf "%d", 100 * (total - idle) / total
		else printf "?"
	}'
}

# --- memoria: ativa / total, em MB -------------------------------------------
memoria() {	# paginas ativas x tamanho da pagina (vm.stats do FreeBSD)
	pag=$(sysctl -n hw.pagesize 2>/dev/null)
	ativa=$(sysctl -n vm.stats.vm.v_active_count 2>/dev/null)
	total=$(sysctl -n hw.physmem 2>/dev/null)
	if [ -n "$pag" ] && [ -n "$ativa" ] && [ -n "$total" ]; then
		printf 'mem %sM/%sM' "$((ativa * pag / 1048576))" "$((total / 1048576))"
	else
		printf 'mem ?'
	fi
}

# --- volume -------------------------------------------------------------------
# mixer -o imprime "vol.volume=esq:dir" (0.00 a 1.00) e "vol.mute=0|1"
nivel_volume() {	# 0-1, canal esquerdo
	mixer -o vol.volume 2>/dev/null | awk -F= '{ split($2, c, ":"); print c[1] }'
}

mudo() {
	[ "$(mixer -o vol.mute 2>/dev/null | cut -d= -f2)" = 1 ]
}

volume() {
	if mudo; then
		printf 'vol mudo'
		return
	fi
	nivel=$(nivel_volume)
	if [ -n "$nivel" ]; then
		printf 'vol %s%%' "$(echo "$nivel" | awk '{ printf "%d", $1 * 100 + 0.5 }')"
	else
		printf 'vol ?'
	fi
}

# --- musica: so aparece enquanto algo toca -----------------------------------
# playerctl (navegador e outros, por MPRIS) primeiro; se nada tocar, o cmus
MAX_MUSICA=40
musica() {
	m=""
	if command -v playerctl >/dev/null &&
	    [ "$(playerctl status 2>/dev/null)" = Playing ]; then
		m=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null)
		m=${m#' - '}
	elif command -v cmus-remote >/dev/null; then
		m=$(cmus-remote -Q 2>/dev/null | awk '
			/^status / { st = $2 }
			/^tag artist / { sub(/^tag artist /, ""); ar = $0 }
			/^tag title / { sub(/^tag title /, ""); ti = $0 }
			END { if (st == "playing") print (ar != "" ? ar " - " ti : ti) }')
	fi
	[ -n "$m" ] || return
	if [ "${#m}" -gt "$MAX_MUSICA" ]; then
		m="$(printf '%s' "$m" | cut -c1-$((MAX_MUSICA - 1)))~"
	fi
	printf '%s | ' "$m"
}

# --- aviso de bateria baixa (uma vez por nivel, ate voltar a carregar) -------
avisado=""	# "", "15" ou "5"
avisar_bateria() {	# $1 = pct
	[ "$PERFIL" = desktop ] && return
	[ -n "$1" ] || return
	command -v notify-send >/dev/null || return
	if na_tomada || [ "$1" -gt 15 ]; then
		avisado=""
		return
	fi
	if [ "$1" -le 5 ] && [ "$avisado" != 5 ]; then
		notify-send -u critical "Bateria em $1%" "Ligue na tomada agora."
		avisado=5
	elif [ "$1" -le 15 ] && [ -z "$avisado" ]; then
		notify-send -u normal "Bateria em $1%" "Hora de procurar a tomada."
		avisado=15
	fi
}

linha() {	# $1 = cpu %, $2 = bateria %
	if [ "$PERFIL" = desktop ]; then
		printf ' %scpu %s%% | %s | %s | %s ' \
		    "$(musica)" "$1" "$(memoria)" "$(volume)" "$(date '+%d/%m %H:%M')"
		return
	fi
	tomada=""
	na_tomada && tomada="+"
	printf ' %scpu %s%% | %s | %s | bat %s%%%s | %s ' \
	    "$(musica)" "$1" "$(memoria)" "$(volume)" "${2:-?}" "$tomada" "$(date '+%d/%m %H:%M')"
}

antes=$(cp_time)

if [ "${1:-}" = "-1" ]; then
	sleep 1
	linha "$(cpu_pct "$antes" "$(cp_time)")" "$(pct_bateria)"
	echo
	exit 0
fi

sleep 1
while :; do
	agora=$(cp_time)
	bat=$(pct_bateria)
	avisar_bateria "$bat"
	xsetroot -name "$(linha "$(cpu_pct "$antes" "$agora")" "$bat")"
	antes=$agora
	sleep "$INTERVALO"
done
